{
  "schema_version": "2.1.0-collective",
  "swarm_name": "Crypto Market Strategy Research Swarm (Quant Turnover Pipeline)",
  "execution_authorized": false,
  "topology": {
    "max_spawn_depth": 6,
    "max_concurrency": 8,
    "max_total_agents": 16,
    "confidence_gate_threshold": -0.25,
    "confidence_gate_probability": 0.779,
    "blackboard_bus": "dnd_rsi_blackboard.sqlite3"
  },
  "deterministic_spawning_rules": [
    {
      "rule_id": "CR1_HYPOTHESIS_GEN",
      "parent_role": "coordinator",
      "child_role": "hypothesis_generator",
      "min_logprob": -0.22,
      "trigger": "market_research_start && depth < 6",
      "transition": "SPAWNING -> ACTIVE -> VALIDATING"
    },
    {
      "rule_id": "CR2_DATA_SCOUTS",
      "parent_role": "hypothesis_generator",
      "child_role": "data_scout",
      "min_logprob": -0.25,
      "trigger": "hypothesis_formulated && concurrency <= 8",
      "transition": "SPAWNING -> ACTIVE -> VALIDATING"
    },
    {
      "rule_id": "CR3_BACKTEST_RUNNER",
      "parent_role": "data_scout",
      "child_role": "backtest_executor",
      "min_logprob": -0.25,
      "trigger": "market_data_fetched && mean_logprob >= -0.25",
      "transition": "SPAWNING -> ACTIVE -> VALIDATING"
    },
    {
      "rule_id": "CR4_VELOCITY_RANK",
      "parent_role": "backtest_executor",
      "child_role": "velocity_ranker",
      "min_logprob": -0.22,
      "trigger": "backtest_complete && pnl_distribution_valid",
      "transition": "SPAWNING -> ACTIVE -> VALIDATING"
    },
    {
      "rule_id": "CR5_RISK_GATE",
      "parent_role": "velocity_ranker",
      "child_role": "risk_critic",
      "min_logprob": -0.18,
      "trigger": "velocity_ranked && drawdown_calculated",
      "transition": "SPAWNING -> ACTIVE -> VALIDATING"
    },
    {
      "rule_id": "CR6_SEAL_SPINDOWN",
      "parent_role": "risk_critic",
      "child_role": "fast_worker",
      "min_logprob": -0.25,
      "trigger": "risk_gate_pass && execution_authorized == false",
      "transition": "VALIDATING -> PASS -> SPINDOWN"
    }
  ],
  "agents": [
    {
      "id": "sabrina",
      "role": "coordinator",
