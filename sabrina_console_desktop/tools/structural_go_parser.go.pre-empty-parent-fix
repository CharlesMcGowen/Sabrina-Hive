package main

import (
	"bufio"
	"encoding/json"
	"go/ast"
	"go/parser"
	"go/token"
	"os"
)

type request struct { Source string `json:"source"` }
type symbol struct {
	ID string `json:"id"`
	Parent string `json:"parent"`
	Kind string `json:"kind"`
	Parameters []map[string]string `json:"parameters"`
	Depth int `json:"depth"`
	Async bool `json:"async_function"`
}
type response struct { Schema int `json:"schema_version"`; Language string `json:"language"`; Symbols []symbol `json:"symbols"`; Error bool `json:"error,omitempty"` }

func parse(source string) response {
	f, err := parser.ParseFile(token.NewFileSet(), "", source, parser.AllErrors)
	if err != nil { return response{Error:true} }
	out := response{Schema:1, Language:"go", Symbols:[]symbol{}}
	parents := []string{}
	depths := map[string]int{}
	ast.Inspect(f, func(n ast.Node) bool {
		if n == nil { if len(parents)>0 { parents=parents[:len(parents)-1] }; return false }
		parent := ""
		if len(parents)>0 { parent=parents[len(parents)-1] }
		id := ""
		switch x := n.(type) {
		case *ast.FuncDecl:
			params := []map[string]string{}
			if x.Type.Params != nil { for _, field := range x.Type.Params.List { count:=len(field.Names); if count==0 { count=1 }; for i:=0;i<count;i++ { params=append(params,map[string]string{"id":"parameter_"+itoa(len(params)+1),"kind":"positional_or_keyword"}) } } }
			id = "symbol_"+itoa(len(out.Symbols)+1)
			depth:=0; if parent!="" { depth=depths[parent]+1 }; depths[id]=depth
			out.Symbols=append(out.Symbols,symbol{ID:id,Parent:parent,Kind:"function",Parameters:params,Depth:depth})
		case *ast.TypeSpec:
			switch x.Type.(type) {
			case *ast.StructType, *ast.InterfaceType:
				id = "symbol_"+itoa(len(out.Symbols)+1)
				depth:=0; if parent!="" { depth=depths[parent]+1 }; depths[id]=depth
				out.Symbols=append(out.Symbols,symbol{ID:id,Parent:parent,Kind:"class",Depth:depth})
			}
		}
		if id!="" { parents=append(parents,id) } else { parents=append(parents,parent) }
		return true
	})
	return out
}

func itoa(n int) string { if n<10 { return string(rune('0'+n)) }; return itoa(n/10)+string(rune('0'+n%10)) }

func main() {
	in:=bufio.NewScanner(os.Stdin); in.Buffer(make([]byte,4096),2*1024*1024)
	out:=bufio.NewWriter(os.Stdout); defer out.Flush()
	for in.Scan() { var req request; var res response; if json.Unmarshal(in.Bytes(),&req)!=nil { res=response{Error:true} } else { res=parse(req.Source) }; _=json.NewEncoder(out).Encode(res); out.Flush() }
}
