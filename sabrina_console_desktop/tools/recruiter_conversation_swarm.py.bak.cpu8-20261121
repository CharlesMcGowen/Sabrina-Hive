def parse_json(raw):
    return json.loads(raw.strip().removeprefix('```json').removeprefix('```').removesuffix('```').strip())


def stage_schema(role,thread,profile):
    """Constrain IDs and structure at decoding; semantic evidence is still checked."""
    text={'type':'string'}
    def enum(values):return {'type':'string','enum':values}
    def array(items):return {'type':'array','items':items}
    def obj(properties):return {'type':'object','properties':properties,'required':list(properties),'additionalProperties':False}
    ids=[m['id'] for m in reversed(thread['messages'][-8:])]
    self_ids=[m['id'] for m in reversed(thread['messages']) if m['ownership']=='self'][:8]
    facts=[f['id'] for f in profile['facts']]
    base={'thread_id':enum([thread['thread_id']]),'context_version':{'type':'integer','enum':[thread['version']]}}
    intent=enum(['recruiter_inquiry','scheduling','networking','spam','other'])
    owner=enum(['user','contact','none'])
    short_quote={'type':'string','minLength':1,'maxLength':220}
    if role=='reader':
        commitments=array(obj({'text':text,'source_id':enum(self_ids),'quote':short_quote})) if self_ids else array(text)
        return obj({**base,'intent':intent,'response_owner':owner,'summary':text,'latest_request':text,
                    'should_reply':{'type':'boolean'},'reason':text,'source_message_ids':{'type':'array','items':enum(ids),'minItems':1,'maxItems':4},
                    'known_role_facts':{'type':'array','maxItems':6,'items':obj({'field':enum(['role','company','location','employment_type','compensation','requirements','job_description','interview_details']),
                                                'value':text,'source_id':enum(ids),'quote':short_quote})},
                    'user_commitments':commitments,'missing_user_information':array(text)})
    approved_facts=array(enum(facts)) if facts else array(text)
    if role=='drafter':
        return obj({**base,'skill_id':enum([s['id'] for s in load_skills()]),'source_message_ids':{'type':'array','items':enum(ids),'minItems':1,'maxItems':4},
                    'intent':intent,'response_owner':owner,'action':enum(['draft_reply','no_reply','ask_human']),
                    'reason':text,'draft':text,'facts_used':approved_facts,'missing_information':array(text),'next_action':text,
                    'opportunities':array(text)})
    return obj({**base,'verdict':enum(['approve','revise','block']),'reason':text,
                'findings':array(obj({'issue':text,'source_id':enum(ids),'quote':short_quote})),
                'facts_verified':approved_facts,'approval_scope':enum(['draft_only'])})


def validate_sources(value, thread):
    if value.get('thread_id') != thread['thread_id'] or value.get('context_version') != thread['version']:
        raise ValueError('Model used the wrong conversation or stale context')
    messages = {m['id']: m for m in thread['messages']}
    return messages


def validate_reader(value, thread, profile=None):
    messages = validate_sources(value, thread)
    if value.get('intent') not in {'recruiter_inquiry','scheduling','networking','spam','other'}:
        raise ValueError('Reader did not classify the actual conversation')
    if value.get('response_owner') not in {'user','contact','none'} or not isinstance(value.get('should_reply'),bool):
        raise ValueError('Reader did not establish who owes the next response')
    ids = value.get('source_message_ids', [])
    if not ids or any(i not in messages for i in ids):
        raise ValueError('Reader did not consider the latest real message')
    if thread['messages'][-1]['id'] not in ids:
        value['source_message_ids'] = [thread['messages'][-1]['id']] + list(ids)
    for key in ['summary','latest_request','reason']:
        if not isinstance(value.get(key),str) or not value[key].strip():
            raise ValueError('Reader omitted the actual request or its reasoning')
    profile_texts = [f.get('text', '') for f in (profile or {}).get('facts', [])]
    for key in ['known_role_facts','user_commitments']:
        if not isinstance(value.get(key),list):raise ValueError('Reader evidence must be a list')
        cleaned = []
        for fact in value[key]:
            if fact.get('source_id') not in messages:
                raise ValueError(key+' must cite CHAT message IDs only. A profile fact is not a chat message or a commitment; remove it from user_commitments and use [] when no self-authored chat promise exists')
            quote = fact.get('quote') or ''
            if not quote:
                raise ValueError('Reader invented or misattributed source evidence')
            if quote not in messages[fact['source_id']]['text']:
                eligible_msgs = [
                    m for m in thread['messages']
                    if quote in m.get('text', '') and (key != 'user_commitments' or m.get('ownership') == 'self')
                ]
                if not eligible_msgs:
                    # If reader mistakenly placed an approved_profile sentence in known_role_facts, drop it rather than treating approved profile text as fabricated chat.
                    if key == 'known_role_facts' and any(quote in pt for pt in profile_texts):
                        continue
                    raise ValueError('Reader invented or misattributed source evidence')
                fact['source_id'] = eligible_msgs[-1]['id']
            if key=='user_commitments' and messages[fact['source_id']]['ownership']!='self':
                raise ValueError('Recruiter claims cannot become user commitments')
            cleaned.append(fact)
        value[key] = cleaned
    if not isinstance(value.get('missing_user_information'),list):raise ValueError('Missing user facts must be explicit')
    return value


def validate_critic(value, thread, profile):
    messages = validate_sources(value, thread)
    if value.get('verdict') not in {'approve','revise','block'} or value.get('approval_scope')!='draft_only':
        raise ValueError('Reviewer cannot grant send authority')
    if not isinstance(value.get('reason'),str) or not value['reason'].strip():raise ValueError('Reviewer omitted reasoning')
    facts = {f['id'] for f in profile['facts']}
    if any(f not in facts for f in value.get('facts_verified',[])):raise ValueError('Reviewer used an unapproved user fact')
    for finding in value.get('findings',[]):
        if finding.get('source_id') not in messages or not finding.get('quote') or finding['quote'] not in messages[finding['source_id']]['text']:
            raise ValueError('Reviewer evidence is not in the captured chat')
    return value


class LocalFamilyCaller:
    """All inference goes through the one authenticated lab coordinator."""
    def __init__(self, board):
        self.board=board

    def __call__(self, review_id, role, spec, attempt, system, packet):
        with caller('recruiter-conversation-swarm','social'):
            client=configured()
            if client is None:raise RuntimeError('Shared lab coordinator must be configured; no direct or cloud fallback')
            operation=f'{review_id}:{role}:{attempt}'
            user_content=json.dumps(packet,ensure_ascii=False,separators=(',',':'))
            latest_msg=packet['thread']['messages'][-1]
            if role in ('reader','drafter'):
                user_content+=(
                    f"\n\nLATEST MESSAGE IN THREAD (ownership={latest_msg.get('ownership')!r}, "
                    f"id={json.dumps(packet['latest_message_id'])}): {json.dumps(latest_msg.get('text',''), ensure_ascii=False)}"
                    f"\nREQUIRED: `source_message_ids` MUST include {json.dumps(packet['latest_message_id'])}."
                )
            if role=='drafter':
                user_content+=(
                    '\nMANDATORY CONSTRAINTS: Return JSON only. Address the current request and earlier unresolved requests. '
                    'Use approved_profile for known facts. Ask the user only for still-missing facts or explicit approvals. '
                    'NEVER draft_reply to personal/ward/friend messages, vendor sales pitches, or polite sign-offs (use ask_human or no_reply with draft=""). '
                    'Do NOT invent days of week (Monday-Sunday), morning/afternoon/evening/AM/PM, or unapproved "$" figures, '
                    'and do NOT tack on unprompted hourly-rate or call-window questions when not asked.'
                )
            msgs=[{'role':'system','content':system},{'role':'user','content':user_content}]
            if packet.get('validation_error_to_correct') and packet.get('previous_rejected_output'):
                msgs.append({'role':'assistant','content':str(packet['previous_rejected_output'])})
                if role=='reader':
                    repair_hint = 'Set `known_role_facts` to [] and `user_commitments` to [] unless quoting an EXACT character-for-character substring from `thread.messages[].text` (never quote contact_dossier or graph_snapshot).'
                elif role=='critic':
                    repair_hint = 'When `verdict` is "approve", `findings` MUST be []. Otherwise every `findings[].quote` MUST be an exact character-for-character substring from `thread.messages[source_id].text` (NEVER quote the draft or blackboard_artifacts).'
                else:
                    repair_hint = 'Remove ALL days of week, morning/afternoon/AM/PM, call time-window requests when calls are paused, false portal-submission claims, and ALL unapproved dollar/rate numbers.'
                msgs.append({'role':'user','content':'VALIDATION REJECTED YOUR OUTPUT: '+str(packet['validation_error_to_correct'])+'. '+repair_hint})
            payload={'model':spec['model'],'stream':False,'format':stage_schema(role,packet['thread'],packet['approved_profile']),
                     'messages':msgs,
                     # Gemma 12B at 32k exceeds the coordinator's 14 GiB GPU budget.
                     'options':{'num_predict':1600 if role=='reader' else 1200,
                                'num_ctx':16384 if role=='drafter' else 12288,
                                'temperature':0.35 if (attempt>1 or role=='drafter') else 0.1}}
            body={'client':client.client,'project':client.project,'operation_id':operation,'path':'/api/chat',
                  'payload':payload,'device':'cpu','request_seconds':180,
                  'task_label':'Recruiter conversation '+role+' (review only)'}
            # Re-submission with the same operation ID reattaches to the same inference.
            receipt=client.request('/v1/inference',body)
            self.board.record_conversation_artifact(review_id,role,attempt,spec['model'],spec['family'],'',request_id=receipt['id'])
            result=client.wait(receipt['id'],seconds=480)
            return {'content':result.get('message',{}).get('content',''), 'request_id':receipt['id'],
                    'model':result.get('model',spec['model']), 'thinking':result.get('message',{}).get('thinking',''),
                    'response':result}


def hold_missing_profile_facts(decision, reader):
    """A model vote cannot authorize a reply while required user facts are missing."""
    missing=decision.get('missing_information') or reader.get('missing_user_information',[])
    outstanding=(reader.get('should_reply') and reader.get('response_owner')=='user'
                 and reader.get('intent') in {'recruiter_inquiry','scheduling'})
    if not missing or not (decision.get('action')=='draft_reply' or
                          (decision.get('action')=='no_reply' and outstanding)):return decision
    return {**decision,'action':'ask_human','draft':'','proposed_text':'','auto_reply_eligible':False,
            'response_owner':'user','missing_information':missing,
            'reason':'User information or approval is still needed: '+', '.join(str(item) for item in missing),
            'next_action':'User answers the outstanding questions before a reply is drafted'}


class RecruiterConversationSwarm:
    def __init__(self, board_path=BOARD_PATH, model_call=None, models=None, progress=None):
        self.models=models or MODELS
        if set(self.models)!= {'reader','drafter','critic'} or len({m['family'] for m in self.models.values()})!=3:
            raise ValueError('Reader, drafter and reviewer require three distinct model families')
        registered={**VERIFIED_LOCAL_MODELS,**{m['model']:m['family'] for m in MODELS.values()}}
        if any(registered.get(m['model'])!=m['family'] for m in self.models.values()):
            raise ValueError('Model families must match the registered, verified local models')
        Path(board_path).parent.mkdir(parents=True,exist_ok=True)
        self.board=HierarchicalCognitiveBlackboard(board_path)
        self.call=model_call or LocalFamilyCaller(self.board)
        self.progress=progress or (lambda role,model:None)

    def close(self):self.board.close()

    def _stage(self, review_id, role, rules, validate):
        run=self.board.conversation_review(review_id)
        for artifact in reversed(run['artifacts']):
            if artifact['role']==role and artifact['parsed'] is not None and not artifact['validation_error']:
                return validate(artifact['parsed'])
        previous_error=None;previous_raw=None
        for attempt in (1,2):
            # Every participant gets the ORIGINAL chat and the ORIGINAL approved profile.
            run=self.board.conversation_review(review_id)
            packet={**run['packet'],'blackboard_artifacts':[
                {'role':a['role'],'model':a['model'],'family':a['family'],'result':a['parsed']}
                for a in run['artifacts'] if a['parsed'] is not None and not a['validation_error']]}
            if previous_error:
                packet['validation_error_to_correct']=previous_error
                packet['previous_rejected_output']=previous_raw
                packet['required_latest_message_id']=run['packet']['thread']['messages'][-1]['id']
            if len(json.dumps(packet,ensure_ascii=False,separators=(',',':')))+len(rules)>52000:
                raise ValueError('Conversation and approved profile exceed the context budget; nothing silently truncated')
            self.progress(role,self.models[role]['model'])
            result=self.call(review_id,role,self.models[role],attempt,rules,packet)
            raw=result['content']
            provenance=json.dumps(result,ensure_ascii=False)
            try:
                if result.get('model',self.models[role]['model'])!=self.models[role]['model']:
                    raise ValueError('A different model answered than the registered independent family')
                response=result.get('response') or {}
                if response.get('done_reason')=='length':
                    raise ValueError('Model response exhausted its context or output budget; truncated review rejected')
                parsed=validate(parse_json(raw))
            except (ValueError,TypeError,KeyError) as exc:
                previous_error=str(exc)
                previous_raw=raw
                self.board.record_conversation_artifact(review_id,role,attempt,result.get('model',self.models[role]['model']),
                    self.models[role]['family'],provenance,validation_error=previous_error,request_id=result.get('request_id'))
                if attempt==2:raise ValueError(role+' model failed validation: '+previous_error) from exc
            else:
                self.board.record_conversation_artifact(review_id,role,attempt,result.get('model',self.models[role]['model']),
                    self.models[role]['family'],provenance,parsed=parsed,request_id=result.get('request_id'))
                self.board.record_hypothesis(review_id+':'+role,'recruiter:'+run['account']+':'+run['thread'],
                    result.get('model',self.models[role]['model']),raw,None,'review_only')
                return parsed

    def review(self, thread, profile=None, prior_delivery=None, graph_snapshot=None, strategy=None, external_portal_outcome=None):
        profile=profile if profile is not None else load_profile()
        graph_snapshot = graph_snapshot or build_snapshot(thread, profile)
        strategy = strategy or plan_strategy(graph_snapshot, thread, prior_delivery)
        compact_requests=[{k:v for k,v in r.items() if k!='exact_text'} for r in graph_snapshot.get('requests',[])]
        # Every original message and its ID remain in thread.messages. The graph's
        # flat ID inventory repeats those long opaque IDs without adding evidence;
        # the remaining omitted fields have explicit counterparts in this packet.
        compact_graph={k:v for k,v in graph_snapshot.items() if k not in {
            'facts','requests','source_message_ids','person','commitments',
            'conversation_state','open_questions','graph_version','profile_hash'}}
        packet={'thread':thread,'latest_message_id':thread['messages'][-1]['id'],'approved_profile':profile,'profile_hash':digest(profile),
                'user_goal':'Understand each recruiter conversation and propose the appropriate next step; avoid repetitive bulk messages.',
                'outbound_permission':'NONE: only a fresh exact per-message approval may authorize a future send',
                'prior_delivery':prior_delivery or [],'policy_version':POLICY_VERSION,
                'external_portal_outcome':external_portal_outcome,
                'contact_dossier':graph_snapshot.get('person',{}),
                'linked_opportunity':(graph_snapshot.get('opportunities') or [None])[0],
                'prior_requests':compact_requests,
                'prior_commitments':graph_snapshot.get('commitments',[]),
                'open_questions':graph_snapshot.get('open_questions',[]),
                'current_relationship_state':graph_snapshot.get('conversation_state',{}),
                'graph_snapshot':compact_graph,
                'graph_version':graph_snapshot.get('graph_version',''),
                'strategy':strategy,'strategy_version':strategy.get('strategy_version','')}
        review_id='recruiter-review-'+digest({'packet':packet,'models':self.models})[:32]
        run=self.board.begin_conversation_review(review_id,packet,self.models)
        if run['status'] in {'draft_ready','no_reply','needs_input'}:return run
        if not thread.get('complete'):
            self.board.finish_conversation_review(review_id,'blocked',error='Captured conversation history is incomplete; no sendable draft is produced')
            return self.board.conversation_review(review_id)
        try:
            with inference_wait_budget(600):
                read=self._stage(review_id,'reader',READER_RULES,lambda v:validate_reader(v,thread,profile))
                if graph_snapshot.get('role_facts') and not read.get('known_role_facts'):
                    read['known_role_facts']=[
                        {'field':f['field'],'value':f['value'],'source_id':f['source_message_ids'][0],'quote':f['source_quote'][:140]}
                        for f in graph_snapshot['role_facts'][:6]
                        if f.get('field') in {'role','company','location','employment_type','compensation','requirements','job_description','interview_details'}
                        and f.get('source_message_ids') and f.get('source_quote')
                    ]
                routed_skills=select_dm_skills(thread,read,external_portal_outcome=external_portal_outcome)
                drafter_rules=DRAFTER_RULES+'\n\n'+routed_skills['compiled_skill_prompt']
                draft=self._stage(review_id,'drafter',drafter_rules,lambda v:validate_decision(
                    {**v,**({'external_portal_outcome':external_portal_outcome} if external_portal_outcome else {})},
                    thread,profile,load_skills()
                ))
                critic=self._stage(review_id,'critic',CRITIC_RULES,lambda v:validate_critic(v,thread,profile))
            metadata={'graph_version':graph_snapshot.get('graph_version',''),
                      'strategy_version':strategy.get('strategy_version',''),
                      'relationship_state':strategy.get('relationship_state','needs_human_review'),
                      'conversation_goal':strategy.get('conversation_goal',''),
                      'open_questions':strategy.get('open_questions',[]),
                      'active_social_skills':routed_skills['selected_skills'],
                      'emoji_budget':routed_skills['tone']['emoji_budget'],
                      **({'external_portal_outcome':external_portal_outcome} if external_portal_outcome else {}),
                      'auto_reply_eligible':False,
                      'proposed_text':strategy.get('proposed_text',''),
                      'role_questions':strategy.get('role_questions',[]),
                      'user_questions':strategy.get('user_questions',[])}
            missing=draft.get('missing_information') or read.get('missing_user_information',[])
            unresolved_delivery=any(item.get('status') in {'sending','uncertain'} or not item.get('status')
                                    for item in (prior_delivery or []))
            if critic['verdict']!='approve':
                decision=fallback(thread,'ask_human','Independent reviewer held the proposal: '+critic['reason'],
                                  intent=read['intent'],response_owner='user',missing_information=missing,
                                  opportunities=draft.get('opportunities',[]),**metadata)
            elif unresolved_delivery and draft['action']=='draft_reply':
                decision=fallback(thread,'ask_human','A prior delivery is unresolved; verify its outcome before drafting another message',
                                  intent=read['intent'],response_owner='user',missing_information=missing,
                                  opportunities=draft.get('opportunities',[]),**metadata)
            elif not read['should_reply'] and draft['action']=='draft_reply':
                decision=fallback(thread,'ask_human','Reader and drafter disagree about whether a reply is due; review the conversation',
                                  intent=read['intent'],response_owner='user',missing_information=missing,
                                  opportunities=draft.get('opportunities',[]),**metadata)
            elif thread['messages'][-1]['ownership']!='external' and draft['action']=='draft_reply':
                decision=fallback(thread,'no_reply','The latest message is already from the account owner',
                                  intent=read['intent'],response_owner='contact',missing_information=[],
                                  opportunities=draft.get('opportunities',[]),**{**metadata,'relationship_state':'awaiting_recruiter'})
            elif strategy.get('relationship_state')=='closed' and draft['action']=='draft_reply':
                decision=fallback(thread,'no_reply','The contact opted out; do not reply',
                                  intent=read['intent'],response_owner='none',missing_information=[],
                                  opportunities=draft.get('opportunities',[]),**{**metadata,'relationship_state':'closed'})
            else:
                is_hiring_intent = (
                    read['intent'] == 'recruiter_inquiry'
                    or (read['intent'] == 'scheduling' and bool(read.get('known_role_facts') or graph_snapshot.get('opportunities')))
                )
                eligible=bool(draft['action']=='draft_reply' and critic['verdict']=='approve'
                              and read['should_reply'] and thread.get('complete')
                              and thread['messages'][-1]['ownership']=='external'
                              and strategy.get('relationship_state')!='closed'
                              and is_hiring_intent)
                decision={**draft,**metadata,'auto_reply_eligible':eligible,
                          'proposed_text':draft.get('draft','') if eligible else strategy.get('proposed_text','')}
            decision=hold_missing_profile_facts(decision,read)
            self.board.finish_conversation_review(review_id,'model_review_complete',decision=decision)
        except Exception as exc:
            self.board.finish_conversation_review(review_id,'blocked',error=str(exc))
        return self.board.conversation_review(review_id)

    def commit(self, review_id, store, fresh_thread, profile=None):
        """Saving a proposal requires a fresh source read and the unchanged profile."""
        run=self.board.conversation_review(review_id)
        if run['status'] in {'model_review_complete','draft_ready'}:
            reader=next((a['parsed'] for a in reversed(run['artifacts'])
                         if a['role']=='reader' and a['parsed'] is not None and not a['validation_error']),{})
            guarded=hold_missing_profile_facts(run.get('decision') or {},reader)
            if guarded!=run.get('decision'):
                # Revalidate cached approvals made before this guard as well.
                self.board.finish_conversation_review(review_id,'model_review_complete',decision=guarded)
                run=self.board.conversation_review(review_id)
        if run['status']!='model_review_complete':return run
        profile=profile if profile is not None else load_profile()
        original=run['packet']['thread']
        keys=('account_id','thread_id','peer_id','version')
        fresh_hash=digest({k:v for k,v in fresh_thread.items() if k!='observed_at'})
        original_hash=digest({k:v for k,v in original.items() if k!='observed_at'})
        if any(fresh_thread[k]!=original[k] for k in keys) or fresh_hash!=original_hash or digest(profile)!=run['profile_hash']:
            self.board.finish_conversation_review(review_id,'stale',error='Conversation or approved profile changed during model review; proposal not accepted')
        else:
            decision=validate_decision(run['decision'],fresh_thread,profile,load_skills())
            profile_hash=digest({'profile':profile,'swarm_policy':POLICY_VERSION,'models':self.models})
            store.save_decision(fresh_thread['account_id'],fresh_thread['thread_id'],fresh_thread['version'],profile_hash,decision)
            status={'draft_reply':'draft_ready','no_reply':'no_reply','ask_human':'needs_input'}[decision['action']]
            self.board.finish_conversation_review(review_id,status,decision=decision)
        return self.board.conversation_review(review_id)
