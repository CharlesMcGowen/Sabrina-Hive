"""Shared capability discovery and handoff contracts for Sabrina agents."""
from __future__ import annotations

from dataclasses import dataclass, asdict
import json
import sqlite3
import time
import uuid
from pathlib import Path


@dataclass(frozen=True)
class Capability:
    name: str
    owner: str
    actions: tuple[str, ...]
    resources: tuple[str, ...] = ()
    availability: str = "ready"


DEFAULT_CAPABILITIES = (
    Capability("linkedin.browser", "social-browser", ("status", "feed_scan", "engage"), ("browser:linkedin-primary",)),
    Capability("linkedin.replies", "social-browser", ("scan", "draft", "publish"), ("browser:linkedin-primary",)),
    Capability("browser.recovery", "desktop-bridge",
               ("preflight", "reconnect", "recreate_forwards", "verify_cdp", "verify_auth"),
               ("browser:linkedin-primary",)),
    Capability("social.semantic_review", "social-research", ("classify", "draft"), ("browser:linkedin-primary",)),
)


class CapabilityRegistry:
    def __init__(self, path: str | Path = "data/control/capabilities.sqlite3"):
        self.path = Path(path)
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with self.db() as db:
            db.execute("CREATE TABLE IF NOT EXISTS handoffs (id TEXT PRIMARY KEY, capability TEXT, objective TEXT, state TEXT, payload TEXT, result TEXT, created REAL, updated REAL)")

    def db(self):
        db = sqlite3.connect(str(self.path), timeout=10)
        db.row_factory = sqlite3.Row
        return db

    def discover(self, action: str | None = None, capability: str | None = None) -> list[dict]:
        values = [asdict(c) for c in DEFAULT_CAPABILITIES if (not capability or c.name == capability)
                  and (not action or action in c.actions)]
        return values

    def handoff(self, capability: str, objective: str, payload: dict | None = None) -> str:
        if not any(c.name == capability for c in DEFAULT_CAPABILITIES):
            raise ValueError(f"Unknown capability: {capability}")
        ident = "cap_" + uuid.uuid4().hex
        now = time.time()
        with self.db() as db:
            db.execute("INSERT INTO handoffs VALUES(?,?,?,?,?,?,?,?)", (ident, capability, objective, "queued", json.dumps(payload or {}), "{}", now, now))
            db.commit()
        return ident

    def complete(self, handoff_id: str, result: dict) -> None:
        with self.db() as db:
            changed = db.execute("UPDATE handoffs SET state='completed',result=?,updated=? WHERE id=? AND state='queued'", (json.dumps(result), time.time(), handoff_id))
            db.commit()
        if changed.rowcount != 1:
            raise ValueError("Unknown or already completed capability handoff")

    def get(self, handoff_id: str) -> dict:
        with self.db() as db:
            row = db.execute("SELECT * FROM handoffs WHERE id=?", (handoff_id,)).fetchone()
        if not row:
            raise KeyError(handoff_id)
        value = dict(row)
        value["payload"] = json.loads(value["payload"])
        value["result"] = json.loads(value["result"])
        return value
