"""Existing-browser, read-only LinkedIn messaging adapter. No composer or send API."""
import re
from pathlib import Path
from urllib.parse import urlparse,unquote

LIST_SCRIPT = r'''() => Array.from(document.querySelectorAll('.msg-conversation-listitem')).map((e,i)=>{
 e.setAttribute('data-sabrina-thread',String(i));
 const name=e.querySelector('.msg-conversation-listitem__participant-names,.msg-conversation-card__participant-names');
 const preview=e.querySelector('.msg-conversation-card__message-snippet');
 return {index:i,name:(name?.innerText||'').trim(),preview:(preview?.innerText||'').trim()};
}).filter(x=>x.name)'''
READ_SCRIPT = r'''() => {
 const root=document.querySelector('.msg-thread');
 if(!root) return null;
 const header=root.querySelector('.msg-entity-lockup__entity-title');
 const peer=root.querySelector('.msg-title-bar a[href*="/in/"]');
 let previous={};
 const messages=Array.from(root.querySelectorAll('[data-event-urn]')).map(e=>{
  const isOther=e.classList.contains('msg-s-event-listitem--other');
  const isSelf=e.classList.contains('msg-s-event-listitem--self');
  const kind=isOther?'external':isSelf?'self':'unknown';
  const name=e.querySelector('.msg-s-message-group__name')?.innerText.trim();
  const link=e.querySelector('a[href*="/in/"]')?.href;
  if(name&&link) previous[kind]={name,id:link};
  const author=previous[kind]|| (kind==='external'&&peer?{name:header?.innerText.trim(),id:peer.href}:{});
  const body=e.querySelector('.msg-s-event-listitem__body');
  const previewCard=e.querySelector('.msg-s-event-listitem__link-preview-container');
  const links=Array.from(e.querySelectorAll('.msg-s-event-listitem__body a[href], .msg-s-event-listitem__link-preview-container a[href]')).map(a=>a.href).filter(h=>h&&!h.includes('linkedin.com/in/'));
  let msgText=(body?.innerText.trim()||previewCard?.innerText.trim()||'');
  for(const href of links){if(href.startsWith('http')&&!msgText.includes(href.split('?')[0])) msgText=(msgText?msgText+'\n':'')+href;}
  const time=e.querySelector('.msg-s-message-group__timestamp');
  const date=e.closest('li')?.querySelector('.msg-s-message-list__time-heading');
  return {id:e.getAttribute('data-event-urn'),author:author.name||'',author_id:author.id||'',
   ownership:kind,text:msgText,links,timestamp_text:time?.innerText.trim()||'',
   date_text:date?.innerText.trim()||'',unsupported:(!body&&!previewCard)||!!e.querySelector('audio,video,.msg-s-event-listitem__attachment')};
 });
 const list=root.querySelector('.msg-s-message-list');
 const loader=root.querySelector('.msg-s-message-list__loader');
 return {url:location.href,peer_name:header?.innerText.trim()||'',peer_id:peer?.href||'',messages,
  at_top:list?list.scrollTop<=2:false,loading:loader?!!loader.getClientRects().length&&!loader.classList.contains('hidden'):false};
}'''

class LinkedInMessagingReader:
    def __init__(self, cdp_url='http://localhost:9222', test_override=False, read_only_session=False):
        from tools.linkedin_manager import LinkedInManager
        self.manager=LinkedInManager(cdp_url=cdp_url)
        self.test_override=test_override
        self.read_only_session=read_only_session
        self.page=None

    def connect(self):
        m=self.manager
        if not m.browser_manager.is_healthy():
            result=m.browser_manager.connect_cdp(cdp_url=m.cdp_url,timeout=300000 if m.cdp_url.startswith('ws') else 5000)
            if result.get('status')!='success':raise RuntimeError('Existing browser unavailable: '+str(result.get('error',result))+'; no replacement profile launched')
        pages=[p for p in m.browser_manager.context.pages if urlparse(p.url).hostname=='www.linkedin.com']
        if not pages:raise RuntimeError('No existing LinkedIn tab')
        self.page=next((p for p in pages if '/messaging/' in p.url),pages[0])
        m.browser_manager._page=self.page
        if self.test_override:
            m.rate_limiter.state['circuit_breaker']={'tripped':False,'reason':'','tripped_at':0,'cooldown_until':0}
        self._guard()
        return self

    def _guard(self):
        if not self.page or self.page.is_closed():raise RuntimeError('Browser disconnected')
        if urlparse(self.page.url).hostname!='www.linkedin.com' or any(x in self.page.url for x in ('/login','/checkpoint','/authwall')):
            raise RuntimeError('LinkedIn authentication required')
        active,reason=self.manager.rate_limiter.is_circuit_breaker_active()
        if active:raise RuntimeError(reason)
        checkpoint,reason=self.manager.stealth.check_checkpoint(self.page)
        if checkpoint:raise RuntimeError(reason)
        if not self.test_override and not getattr(self,'read_only_session',False):
            within,reason=self.manager.rate_limiter.is_within_operating_hours()
            if not within:raise RuntimeError(reason)

    def list_threads(self, limit=4):
        self._guard()
        allowed,reason=self.manager.rate_limiter.check_quota('inbox_check')
        if not allowed:raise RuntimeError(reason)
        if '/messaging/' not in self.page.url:
            self.page.goto('https://www.linkedin.com/messaging/',wait_until='domcontentloaded',timeout=30000)
        self.page.locator('.msg-conversation-listitem').first.wait_for(state='visible',timeout=15000)
        self._guard()
        limit=max(1,min(int(limit),50))
        pane=self.page.locator('.msg-conversations-container__conversations-list')
        if pane.count()!=1:raise RuntimeError('Conversation list pane is ambiguous')
        rows={};stalled=0;previous=-1
        while len(rows)<limit and stalled<3:
            for row in self.page.evaluate(LIST_SCRIPT):rows[row['index']]=row
            state=pane.evaluate('e=>({top:e.scrollTop,height:e.scrollHeight,view:e.clientHeight})')
            if state['top']+state['view']>=state['height']-2:
                pane.evaluate('e=>e.scrollTop=e.scrollHeight')
            else:
                pane.evaluate('(e,y)=>e.scrollTop=y',min(state['height'],state['top']+max(300,state['view']*.8)))
            self.page.wait_for_timeout(700)
            count=len(rows);stalled=stalled+1 if count==previous else 0;previous=count
        pane.evaluate('e=>e.scrollTop=0');self.page.wait_for_timeout(500)
        rows=[rows[i] for i in sorted(rows)[:limit]]
        if not rows:raise RuntimeError('Inbox selectors or identity unavailable; not an empty inbox')
        self.manager.rate_limiter.record_action('inbox_check',{'workflow':'review_only','threads':len(rows)})
        return rows

    def read_thread(self, item, max_scrolls=8):
        self._guard()
        selector='[data-sabrina-thread="'+str(int(item['index']))+'"]'
        target=self.page.locator(selector)
        if target.count()!=1:raise RuntimeError('Conversation list changed')
        target.scroll_into_view_if_needed(timeout=5000)
        target.locator('.msg-conversation-listitem__participant-names,.msg-conversation-card__participant-names').wait_for(state='visible',timeout=5000)
        actual=target.locator('.msg-conversation-listitem__participant-names,.msg-conversation-card__participant-names').inner_text().strip()
        if actual!=item['name']:raise RuntimeError('Conversation identity changed')
        target.locator('.msg-conversation-listitem__link').click(timeout=5000)
        self.page.wait_for_function(r'''name=>document.querySelector('.msg-thread .msg-entity-lockup__entity-title')?.innerText.trim()===name''',arg=item['name'],timeout=15000)
        return self._read_selected(item['name'],max_scrolls)

    def _read_selected(self, expected_name, max_scrolls=8):
        self.page.locator('.msg-thread [data-event-urn]').first.wait_for(state='attached',timeout=15000)
        ordered=[];messages={};stable=0;previous=None;complete=False
        first_url=self.page.url
        for _ in range(max_scrolls):
            self._guard()
            snapshot=self.page.evaluate(READ_SCRIPT)
            if not snapshot or snapshot['url']!=first_url or snapshot['peer_name']!=expected_name:
                raise RuntimeError('User or application changed the selected thread')
            ids=[m['id'] for m in snapshot['messages']]
            ordered=ids+[i for i in ordered if i not in ids]
            messages.update({m['id']:m for m in snapshot['messages']})
            # Compare stable message contents only; inherited group metadata can be absent in virtualized rows.
            signature=tuple((m['id'],m['text']) for m in snapshot['messages'])
            stable=stable+1 if signature==previous and snapshot['at_top'] and not snapshot['loading'] else 0
            previous=signature
            if stable>=2:
                complete=True;break
            self.page.locator('.msg-thread .msg-s-message-list').evaluate('e=>e.scrollTop=0')
            self.page.wait_for_timeout(800)
        snapshot['messages']=[messages[i] for i in ordered]
        return self.normalize(snapshot,complete)

    def read_saved_thread(self, expected):
        self._guard()
        target=urlparse(expected['url'])
        if target.scheme!='https' or target.hostname!='www.linkedin.com' or not re.fullmatch(r'/messaging/thread/[^/]+/?',target.path):
            raise ValueError('Invalid saved LinkedIn thread URL')
        self.page.goto(expected['url'],wait_until='domcontentloaded',timeout=30000)
        self.page.wait_for_function(r"""name=>document.querySelector('.msg-thread .msg-entity-lockup__entity-title')?.innerText.trim()===name""",arg=expected['peer_name'],timeout=15000)
        result=self._read_selected(expected['peer_name'])
        for key in ('account_id','thread_id','peer_id'):
            if result[key].rstrip('/')!=expected[key].rstrip('/'):
                raise RuntimeError('Saved thread identity mismatch: '+key)
        return result

    @staticmethod
    def normalize(raw, complete):
        url=raw['url'];match=re.fullmatch(r'/messaging/thread/([^/]+)/?',urlparse(url).path)
        if not match:raise ValueError('Missing stable platform thread ID')
        messages=raw['messages']
        owners={re.search(r'urn:li:msg_message:\((urn:li:fsd_profile:[^,]+),',m['id']).group(1)
                for m in messages if re.search(r'urn:li:msg_message:\((urn:li:fsd_profile:[^,]+),',m['id'])}
        if len(owners)!=1:raise ValueError('Unable to establish a unique mailbox account ID')
        account=owners.pop()
        for m in messages:
            # Older layouts omit the self CSS class. The opaque author profile ID
            # can still be matched exactly against the mailbox owner in the message URN.
            profile_id=urlparse(m.get('author_id','')).path.rstrip('/').split('/')[-1]
            if profile_id==account.rsplit(':',1)[-1]:m['ownership']='self'
            if m['ownership']=='self':m['author_id']=account
        reasons=[]
        if not complete:reasons.append('History did not stabilize at the top within the read budget')
        if not raw.get('peer_id'):reasons.append('Missing stable participant profile ID')
        if any(m['unsupported'] for m in messages):reasons.append('Attachment or unsupported message content requires human review')
        if any(m['ownership']=='unknown' or not m['author_id'] or not m['text'] for m in messages):reasons.append('Message identity or text is incomplete')
        if not messages:reasons.append('No messages captured')
        return {'account_id':account,'thread_id':unquote(match.group(1)),'url':url,
                'peer_name':raw['peer_name'],'peer_id':raw.get('peer_id',''),
                'messages':messages,'complete':not reasons,'completeness_reasons':reasons,
                'completeness_basis':'bounded top-of-history stabilization; no attachment interpretation'}

    def disconnect(self):
        # Stop only our driver; never close the user's browser or tab.
        manager=self.manager.browser_manager
        try:
            if manager._playwright:manager._playwright.stop()
        finally:
            # Clear stopped driver handles so a later runtime pass cannot try to
            # close stale Page/Context objects belonging to the user's browser.
            manager._page=None;manager._context=None;manager._browser=None;manager._playwright=None
            manager._connected_via_cdp=False

