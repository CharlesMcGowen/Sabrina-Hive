# =====================================================================
# Sabrina Operator Console - Environment Template
# Copy this file to .env and configure optional model provider API keys.
# Note: Keys can also be added interactively via the built-in Vault UI.
# =====================================================================

# Google Gemini API
GEMINI_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# Anthropic API
ANTHROPIC_API_KEY=

# OpenRouter API
OPENROUTER_API_KEY=

# Local Ollama Host (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434
SABRINA_OLLAMA_BASE_URL=http://127.0.0.1:11434
SABRINA_LAB_HOST=localhost
SABRINA_FORGEJO_URL=http://127.0.0.1:3003
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
HITL_GATE_URL=http://127.0.0.1:8890
SABRINA_REDIS_URL=redis://127.0.0.1:6379/0
SABRINA_CONFIG_PATH=sabrina_config.json

# Safety Policy Invariant (Must remain False for non-autonomous operation)
EXECUTION_AUTHORIZED=False
